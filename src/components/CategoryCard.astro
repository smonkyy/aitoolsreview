---
interface Props {
	icon: string;
	title: string;
	description: string;
	tools: string[];
	href: string;
	accent: string;
	/** 0-based index for stagger reveal delay (optional) */
	index?: number;
}

const { icon, title, description, tools, href, accent, index = 0 } = Astro.props;

// Stagger delay in ms: 0 → 0ms, 1 → 100ms, 2 → 200ms, 3 → 300ms
const revealDelay = index * 100;
---

<a
	href={href}
	class="group relative p-6 rounded-2xl border overflow-hidden transition-all duration-300 no-underline block card-glow-hover
		bg-light-card border-light-border
		dark:bg-ai-card dark:border-ai-border"
	data-reveal
	data-reveal-delay={revealDelay > 0 ? String(revealDelay) : undefined}
>
	<!-- Gradient wash on hover -->
	<div
		class={`absolute inset-0 bg-gradient-to-br ${accent} opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none`}
	></div>

	<!-- Shimmer top line -->
	<div
		class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-ai-purple/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
	></div>

	<!-- Index badge (top-right, subtle) -->
	<span
		class="absolute top-4 right-4 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold
			bg-light-bg2 border border-light-border text-light-faint
			dark:bg-ai-bg dark:border-ai-border dark:text-ai-faint
			group-hover:border-ai-purple/40 group-hover:text-ai-purple transition-colors duration-200"
		aria-hidden="true"
	>
		{index + 1}
	</span>

	<div class="relative z-10 flex flex-col h-full">
		<!-- Icon container -->
		<div
			class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5 text-3xl
				bg-light-bg2 dark:bg-ai-bg border border-light-border dark:border-ai-border
				group-hover:scale-110 group-hover:border-ai-purple/40 group-hover:shadow-[0_0_16px_rgba(168,85,247,0.20)] transition-all duration-300"
		>
			{icon}
		</div>

		<h3
			class="text-lg font-bold mb-2 pr-6
				text-light-text dark:text-ai-text
				group-hover:text-ai-purple transition-colors duration-200"
		>
			{title}
		</h3>

		<p class="text-sm text-light-muted dark:text-ai-muted mb-5 leading-relaxed flex-1">
			{description}
		</p>

		<!-- Tool pills -->
		<div class="flex flex-wrap gap-1.5 mb-5">
			{tools.map((tool) => (
				<span
					class="px-2.5 py-0.5 text-xs rounded-full font-medium
						bg-light-bg border border-light-border text-light-faint
						dark:bg-ai-bg dark:border-ai-border dark:text-ai-faint
						group-hover:border-ai-purple/25 transition-colors duration-200"
				>
					{tool}
				</span>
			))}
		</div>

		<!-- CTA arrow -->
		<span
			class="inline-flex items-center gap-1.5 text-ai-purple text-sm font-semibold
				group-hover:gap-3 transition-all duration-200"
		>
			Esplora
			<svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
			</svg>
		</span>
	</div>
</a>

---
import { SITE_TITLE } from '../consts';
import Logo from './Logo.astro';
---

<header
	id="site-header"
	class="fixed top-0 w-full z-50 border-b border-light-border bg-light-bg/98 dark:border-ai-border dark:bg-ai-bg/98 transition-all duration-300"
>
	<nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">

		<!-- Logo -->
		<a
			href="/"
			class="flex items-center no-underline hover:opacity-85 transition-opacity duration-150"
			aria-label={SITE_TITLE}
		>
			<Logo size="md" />
		</a>

		<!-- Desktop Navigation -->
		<div class="hidden md:flex items-center gap-1">
			<a href="/" class="nav-link" data-navlink>Home</a>
			<a href="/strumenti" class="nav-link" data-navlink>Strumenti</a>
			<a href="/confronta" class="nav-link" data-navlink>Confronta</a>
			<a href="/blog" class="nav-link" data-navlink>Blog</a>
			<a href="/about" class="nav-link" data-navlink>Chi siamo</a>
		</div>

		<div class="flex items-center gap-1.5">
			<!-- Dark mode toggle -->
			<button
				id="theme-toggle"
				aria-label="Cambia tema"
				class="p-2 rounded-lg text-light-muted dark:text-ai-muted hover:text-light-text dark:hover:text-ai-text hover:bg-light-bg2 dark:hover:bg-ai-card transition-all duration-200"
			>
				<!-- Sun icon (shown in dark mode → click to go light) -->
				<svg id="sun-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
						d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"
					/>
				</svg>
				<!-- Moon icon (shown in light mode → click to go dark) -->
				<svg id="moon-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
						d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
					/>
				</svg>
			</button>

			<!-- Mobile hamburger -->
			<button
				id="mobile-menu-btn"
				aria-label="Apri menu"
				aria-expanded="false"
				class="md:hidden p-2 rounded-lg text-light-muted dark:text-ai-muted hover:text-light-text dark:hover:text-ai-text hover:bg-light-bg2 dark:hover:bg-ai-card transition-all duration-200"
			>
				<svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
				<svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
	</nav>

	<!-- Mobile Menu — uses CSS grid trick for smooth slide animation -->
	<div
		id="mobile-menu"
		class="md:hidden border-t border-light-border dark:border-ai-border"
		aria-hidden="true"
	>
		<div class="menu-inner bg-light-bg dark:bg-ai-bg px-4 pb-4">
			<div class="flex flex-col gap-1 pt-3">
				<a href="/" class="mobile-nav-link" data-mobile-navlink>Home</a>
				<a href="/strumenti" class="mobile-nav-link" data-mobile-navlink>Strumenti</a>
				<a href="/confronta" class="mobile-nav-link" data-mobile-navlink>Confronta</a>
				<a href="/blog" class="mobile-nav-link" data-mobile-navlink>Blog</a>
				<a href="/about" class="mobile-nav-link" data-mobile-navlink>Chi siamo</a>
			</div>
		</div>
	</div>
</header>

<!-- Spacer to offset fixed header -->
<div class="h-16"></div>

<style>
	/* ── Desktop nav links ─────────────────────────────────── */
	.nav-link {
		position: relative;
		padding: 0.4rem 0.75rem;
		border-radius: 0.5rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-light-muted);
		transition: all 0.15s;
		text-decoration: none;
	}
	.nav-link:hover,
	.nav-link.active {
		color: var(--color-light-text);
		background-color: var(--color-light-bg2);
	}
	.dark .nav-link {
		color: var(--color-ai-muted);
	}
	.dark .nav-link:hover {
		color: var(--color-ai-text);
		background-color: var(--color-ai-card);
	}
	/* Active state: violet text + subtle underline */
	.nav-link.active {
		color: var(--color-ai-purple);
		background-color: color-mix(in srgb, var(--color-ai-purple) 8%, transparent);
	}
	.dark .nav-link.active {
		color: var(--color-ai-purple);
		background-color: color-mix(in srgb, var(--color-ai-purple) 10%, transparent);
	}
	/* Underline accent for active */
	.nav-link.active::after {
		content: '';
		position: absolute;
		bottom: 2px;
		left: 50%;
		transform: translateX(-50%);
		width: 16px;
		height: 2px;
		border-radius: 999px;
		background-color: var(--color-ai-purple);
		opacity: 0.7;
	}

	/* ── Mobile nav links ───────────────────────────────────── */
	.mobile-nav-link {
		display: block;
		padding: 0.65rem 0.85rem;
		border-radius: 0.5rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--color-light-muted);
		text-decoration: none;
		transition: all 0.15s;
	}
	.mobile-nav-link:hover {
		color: var(--color-light-text);
		background-color: var(--color-light-bg2);
	}
	.dark .mobile-nav-link {
		color: var(--color-ai-muted);
	}
	.dark .mobile-nav-link:hover {
		color: var(--color-ai-text);
		background-color: var(--color-ai-card);
	}
	.mobile-nav-link.active {
		color: var(--color-ai-purple);
		background-color: color-mix(in srgb, var(--color-ai-purple) 10%, transparent);
	}
</style>

<script>
	// ── Theme toggle ──────────────────────────────────────────
	const toggle = document.getElementById('theme-toggle');
	const sunIcon = document.getElementById('sun-icon');
	const moonIcon = document.getElementById('moon-icon');

	function syncIcons() {
		const isDark = document.documentElement.classList.contains('dark');
		sunIcon?.classList.toggle('hidden', !isDark);
		moonIcon?.classList.toggle('hidden', isDark);
	}
	syncIcons();

	toggle?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		syncIcons();
	});

	// ── Mobile menu (slide via CSS grid trick) ────────────────
	const mobileBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');
	const hamburgerIcon = document.getElementById('hamburger-icon');
	const closeIcon = document.getElementById('close-icon');

	let menuOpen = false;

	mobileBtn?.addEventListener('click', () => {
		menuOpen = !menuOpen;
		mobileMenu?.classList.toggle('menu-open', menuOpen);
		mobileMenu?.setAttribute('aria-hidden', String(!menuOpen));
		hamburgerIcon?.classList.toggle('hidden', menuOpen);
		closeIcon?.classList.toggle('hidden', !menuOpen);
		mobileBtn.setAttribute('aria-expanded', String(menuOpen));
		mobileBtn.setAttribute('aria-label', menuOpen ? 'Chiudi menu' : 'Apri menu');
	});

	// ── Header scroll shadow ──────────────────────────────────
	const header = document.getElementById('site-header');

	function onScroll() {
		header?.classList.toggle('header-scrolled', window.scrollY > 8);
	}
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll(); // run once on load

	// ── Active nav link ───────────────────────────────────────
	const currentPath = window.location.pathname;

	document.querySelectorAll('[data-navlink], [data-mobile-navlink]').forEach((link) => {
		const href = link.getAttribute('href') ?? '';
		const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
		if (isActive) link.classList.add('active');
	});
</script>

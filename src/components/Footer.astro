---
const today = new Date();
---

<footer class="border-t border-light-border dark:border-ai-border bg-light-bg dark:bg-ai-bg mt-20">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">

			<!-- Brand -->
			<div>
				<a href="/" class="flex items-center gap-2 text-lg font-bold text-light-text dark:text-ai-text no-underline mb-3">
					<span class="text-ai-purple">⚡</span>
					AI Tools Review
				</a>
				<p class="text-sm text-light-muted dark:text-ai-muted leading-relaxed max-w-xs">
					Recensioni oneste dei migliori tool AI, scritte in italiano da chi li usa ogni giorno.
				</p>
			</div>

			<!-- Links -->
			<div>
				<h4 class="text-sm font-semibold text-light-text dark:text-ai-text uppercase tracking-wide mb-4">Esplora</h4>
				<ul class="space-y-2">
					<li><a href="/" class="footer-link">Home</a></li>
					<li><a href="/strumenti" class="footer-link">Strumenti AI</a></li>
					<li><a href="/blog" class="footer-link">Blog & Recensioni</a></li>
					<li><a href="/about" class="footer-link">Chi siamo</a></li>
				</ul>
			</div>

			<!-- Legal + Social -->
			<div>
				<h4 class="text-sm font-semibold text-light-text dark:text-ai-text uppercase tracking-wide mb-4">Info</h4>
				<ul class="space-y-2 mb-6">
					<li><a href="/privacy" class="footer-link">Privacy Policy</a></li>
					<li><a href="/cookie" class="footer-link">Cookie Policy</a></li>
					<li>
						<a href="mailto:shekokri18@gmail.com" class="footer-link">Contatti</a>
					</li>
				</ul>
				<!-- Social -->
				<div class="flex gap-3">
					<a
						href="https://x.com"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Seguici su X (Twitter)"
						class="p-2 rounded-lg text-light-muted dark:text-ai-muted hover:text-light-text dark:hover:text-ai-text hover:bg-light-bg2 dark:hover:bg-ai-card transition-all duration-200"
					>
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
						</svg>
					</a>
					<a
						href="https://linkedin.com"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Seguici su LinkedIn"
						class="p-2 rounded-lg text-light-muted dark:text-ai-muted hover:text-light-text dark:hover:text-ai-text hover:bg-light-bg2 dark:hover:bg-ai-card transition-all duration-200"
					>
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
					</a>
				</div>
			</div>
		</div>

		<!-- Bottom bar -->
		<div class="border-t border-light-border dark:border-ai-border mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3">
			<p class="text-sm text-light-faint dark:text-ai-faint">
				&copy; {today.getFullYear()} AI Tools Review. Tutti i diritti riservati.
			</p>
			<p class="text-xs text-light-faint dark:text-ai-faint">
				Alcuni link potrebbero essere affiliati — le recensioni rimangono sempre indipendenti.
			</p>
		</div>
	</div>
</footer>

<style>
	.footer-link {
		font-size: 0.875rem;
		color: var(--color-light-muted);
		text-decoration: none;
		transition: color 0.15s;
	}
	.footer-link:hover {
		color: var(--color-ai-purple);
	}
	.dark .footer-link {
		color: var(--color-ai-muted);
	}
	.dark .footer-link:hover {
		color: var(--color-ai-purple);
	}
</style>

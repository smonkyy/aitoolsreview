---
interface Props {
	id: string;
	title: string;
	description: string;
	pubDate: Date;
	readTime: number;
	gradient: string;
	/** Optional category label shown on the image badge (default: "Recensione") */
	category?: string;
	/** 0-based index for stagger reveal delay (optional) */
	index?: number;
	/**
	 * When true, the thumbnail loads eagerly with high fetchpriority.
	 * Set on the first card in any grid — it is the likely LCP candidate.
	 */
	priority?: boolean;
}

const {
	id,
	title,
	description,
	pubDate,
	readTime,
	category = 'Recensione',
	index = 0,
	priority = false,
} = Astro.props;

const revealDelay = index * 100;

const dateStr = pubDate.toLocaleDateString('it-IT', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
});

// Colore accent e gradiente basato sul tipo di contenuto
const CATEGORY_STYLE: Record<string, { from: string; accent: string; icon: string }> = {
	'Recensione': { from: 'from-violet-600/30 via-indigo-500/10',  accent: '#a855f7', icon: '★' },
	'Confronto':  { from: 'from-blue-600/30 via-cyan-500/10',      accent: '#3b82f6', icon: '⇄' },
	'Guida':      { from: 'from-emerald-600/25 via-teal-500/10',   accent: '#10b981', icon: '◎' },
};
const style = CATEGORY_STYLE[category] ?? CATEGORY_STYLE['Recensione'];

// Numero ordinale con zero-padding per elemento decorativo
const num = String(index + 1).padStart(2, '0');
---

<a
	href={`/blog/${id}/`}
	class="group block rounded-2xl border overflow-hidden no-underline card-glow-hover
		bg-light-card border-light-border
		dark:bg-ai-card dark:border-ai-border"
	data-reveal
	data-reveal-delay={revealDelay > 0 ? String(revealDelay) : undefined}
>
	<!-- Thumbnail — gradient hero costruito con i dati dell'articolo.
	     Le OG image rimangono per social sharing (og:image meta tag),
	     ma non vengono usate come thumbnail: a 176px risultano illeggibili. -->
	<div class={`relative h-44 overflow-hidden bg-gradient-to-br ${style.from} to-ai-bg dark:to-ai-bg`}>

		<!-- Grid pattern sottile -->
		<div class="absolute inset-0 opacity-[0.06]"
			style="background-image: linear-gradient(var(--color-ai-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-ai-border) 1px, transparent 1px); background-size: 24px 24px;"/>

		<!-- Glow centrale -->
		<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 rounded-full pointer-events-none"
			style={`background: radial-gradient(ellipse, ${style.accent}22 0%, transparent 70%);`}/>

		<!-- Numero decorativo in alto a destra -->
		<span class="absolute top-4 right-5 text-6xl font-black leading-none select-none pointer-events-none"
			style={`color: ${style.accent}18;`}>
			{num}
		</span>

		<!-- Icona decorativa centrata -->
		<span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-4xl select-none pointer-events-none transition-transform duration-300 group-hover:scale-110"
			style={`color: ${style.accent}55;`}>
			{style.icon}
		</span>

		<!-- Gradient fade verso il basso per il badge -->
		<div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-ai-bg/70 to-transparent pointer-events-none"/>

		<!-- Category badge -->
		<div class="absolute bottom-3 left-3">
			<span class="px-2.5 py-1 text-xs font-bold rounded-full backdrop-blur-sm border"
				style={`background: ${style.accent}22; color: ${style.accent}; border-color: ${style.accent}44;`}>
				{category}
			</span>
		</div>
	</div>

	<!-- Content -->
	<div class="p-5">
		<div class="flex items-center gap-2 text-xs text-light-faint dark:text-ai-faint mb-2.5">
			<time datetime={pubDate.toISOString()}>{dateStr}</time>
			<span class="w-1 h-1 rounded-full bg-current opacity-40 shrink-0" aria-hidden="true"></span>
			<span>{readTime} min di lettura</span>
		</div>

		<h3
			class="font-bold text-sm leading-snug mb-2 line-clamp-2
				text-light-text dark:text-ai-text group-hover:text-ai-purple transition-colors duration-150"
		>
			{title}
		</h3>

		<p class="text-xs leading-relaxed line-clamp-2 text-light-muted dark:text-ai-muted">
			{description}
		</p>

		<div class="mt-4 pt-3.5 border-t border-light-border dark:border-ai-border flex items-center justify-between">
			<span
				class="text-xs text-ai-purple font-semibold inline-flex items-center gap-1
					group-hover:gap-2 transition-all duration-150"
			>
				Leggi la recensione
				<svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
				</svg>
			</span>
			<span class="text-xs text-light-faint dark:text-ai-faint">{readTime} min</span>
		</div>
	</div>
</a>

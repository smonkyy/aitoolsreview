---
interface Props {
	id: string;
	title: string;
	description: string;
	pubDate: Date;
	readTime: number;
	gradient: string;
	/** Optional category label shown on the image badge (default: "Recensione") */
	category?: string;
	/** 0-based index for stagger reveal delay (optional) */
	index?: number;
	priority?: boolean;
}

const {
	id,
	title,
	description,
	pubDate,
	readTime,
	category = 'Recensione',
	index = 0,
} = Astro.props;

const revealDelay = index * 100;

const dateStr = pubDate.toLocaleDateString('it-IT', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
});

// Short title: tutto prima del ":" o dei "–" — usato come headline nel thumbnail
const shortTitle = title.split(/[:\–|]/)[0].trim();

// Stile per tipo di contenuto — gradient più saturi e specifici
type StyleKey = 'Recensione' | 'Confronto' | 'Guida';
const STYLE: Record<StyleKey, {
	bg: string;        // CSS gradient inline (più controllo di Tailwind)
	accent: string;    // hex per elementi SVG/glow
	bar: string;       // barra top
	textColor: string; // colore titolo nel thumbnail
}> = {
	Recensione: {
		bg:        'linear-gradient(135deg, #3a2e12 0%, #241d0c 45%, #0d0d0d 100%)',
		accent:    '#c9a84c',
		bar:       'linear-gradient(90deg, #a8863a, #f0d78c, transparent)',
		textColor: '#f0d78c',
	},
	Confronto: {
		bg:        'linear-gradient(135deg, #1e3a5f 0%, #1e2d45 45%, #0d0d0d 100%)',
		accent:    '#60a5fa',
		bar:       'linear-gradient(90deg, #2563eb, #60a5fa, transparent)',
		textColor: '#bfdbfe',
	},
	Guida: {
		bg:        'linear-gradient(135deg, #064e3b 0%, #1a2e27 45%, #0d0d0d 100%)',
		accent:    '#34d399',
		bar:       'linear-gradient(90deg, #059669, #34d399, transparent)',
		textColor: '#a7f3d0',
	},
};
const s = STYLE[(category as StyleKey)] ?? STYLE.Recensione;

// CTA label
const ctaLabel = category === 'Guida' ? 'Leggi la guida' : category === 'Confronto' ? 'Leggi il confronto' : 'Leggi la recensione';
---

<a
	href={`/blog/${id}/`}
	class="group block rounded-2xl border overflow-hidden no-underline card-glow-hover
		bg-light-card border-light-border
		dark:bg-ai-card dark:border-ai-border"
	data-reveal
	data-reveal-delay={revealDelay > 0 ? String(revealDelay) : undefined}
>
	<!-- ── Thumbnail ─────────────────────────────────────────────────────── -->
	<div class="relative h-44 overflow-hidden" style={`background: ${s.bg};`}>

		<!-- Barra accent in cima -->
		<div class="absolute top-0 inset-x-0 h-[3px]" style={`background: ${s.bar};`}/>

		<!-- Grid pattern sottile -->
		<div class="absolute inset-0"
			style="background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 28px 28px;"/>

		<!-- Glow angolo in alto a sinistra -->
		<div class="absolute -top-10 -left-10 w-40 h-40 rounded-full pointer-events-none"
			style={`background: radial-gradient(ellipse, ${s.accent}30 0%, transparent 65%);`}/>

		<!-- Testo short title — elemento visivo principale -->
		<div class="absolute inset-0 flex flex-col justify-center px-5 pt-2">
			<p class="text-xs font-bold uppercase tracking-widest mb-2 opacity-60"
				style={`color: ${s.accent};`}>
				{category}
			</p>
			<h4 class="font-extrabold leading-tight line-clamp-3"
				style={`font-size: clamp(1rem, 3.5vw, 1.25rem); color: ${s.textColor}; letter-spacing: -0.02em;`}>
				{shortTitle}
			</h4>
		</div>

		<!-- Numero indice in basso a destra — sottile, decorativo -->
		<span class="absolute bottom-3 right-4 text-5xl font-black leading-none select-none pointer-events-none"
			style={`color: ${s.accent}14; font-variant-numeric: tabular-nums;`}>
			{String(index + 1).padStart(2, '0')}
		</span>

		<!-- Fade bottom per blend col contenuto -->
		<div class="absolute inset-x-0 bottom-0 h-10 pointer-events-none"
			style="background: linear-gradient(to top, rgba(26,31,46,0.6), transparent);"/>
	</div>

	<!-- ── Content ───────────────────────────────────────────────────────── -->
	<div class="p-5">
		<div class="flex items-center gap-2 text-xs text-light-faint dark:text-ai-faint mb-2.5">
			<time datetime={pubDate.toISOString()}>{dateStr}</time>
			<span class="w-1 h-1 rounded-full bg-current opacity-40 shrink-0" aria-hidden="true"/>
			<span>{readTime} min di lettura</span>
		</div>

		<h3 class="font-bold text-sm leading-snug mb-2 line-clamp-2
			text-light-text dark:text-ai-text group-hover:text-ai-gold transition-colors duration-150">
			{title}
		</h3>

		<p class="text-xs leading-relaxed line-clamp-2 text-light-muted dark:text-ai-muted">
			{description}
		</p>

		<div class="mt-4 pt-3.5 border-t border-light-border dark:border-ai-border flex items-center justify-between">
			<span class="text-xs text-ai-gold font-semibold inline-flex items-center gap-1
				group-hover:gap-2 transition-all duration-150">
				{ctaLabel}
				<svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
				</svg>
			</span>
			<span class="text-xs text-light-faint dark:text-ai-faint">{readTime} min</span>
		</div>
	</div>
</a>

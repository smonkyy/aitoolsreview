---
import { TOOLS } from '../../data/tools';
import { CATEGORY_PAGES, getCategoryPage } from '../../data/category-pages';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return CATEGORY_PAGES.map(p => ({
    params: { category: p.slug },
    props:  { pageData: p },
  }));
}

const { pageData } = Astro.props;

// Top tools (max 3) resolved from TOOLS array
const topTools = pageData.topToolIds
  .map(id => TOOLS.find(t => t.id === id))
  .filter(Boolean) as typeof TOOLS;

// All tools in this category (primary + secondary)
const categoryTools = TOOLS.filter(
  t => t.category === pageData.category || t.secondaryCategories?.includes(pageData.category)
);

// All comparison pairs in category → /confronta/a-vs-b
function comparisonSlug(a: string, b: string) {
  const ia = TOOLS.findIndex(t => t.id === a);
  const ib = TOOLS.findIndex(t => t.id === b);
  return ia < ib ? `${a}-vs-${b}` : `${b}-vs-${a}`;
}

const pairs: Array<{ slugA: string; nameA: string; slugB: string; nameB: string; href: string }> = [];
for (let i = 0; i < categoryTools.length; i++) {
  for (let j = i + 1; j < categoryTools.length; j++) {
    const a = categoryTools[i];
    const b = categoryTools[j];
    pairs.push({
      slugA: a.id, nameA: a.name,
      slugB: b.id, nameB: b.name,
      href: `/confronta/${comparisonSlug(a.id, b.id)}`,
    });
  }
}

// Resolve use-case recommendations
const useCasesResolved = pageData.useCases.map(uc => ({
  ...uc,
  tool: TOOLS.find(t => t.id === uc.toolId),
}));

// Resolve user profile recommendations
const profilesResolved = pageData.userProfiles.map(p => ({
  ...p,
  tool: TOOLS.find(t => t.id === p.toolId),
}));

// FAQ schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pageData.faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const siteUrl = String(Astro.site);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Migliore AI per', item: `${siteUrl}migliore-ai-per` },
    { '@type': 'ListItem', position: 3, name: pageData.h1, item: new URL(Astro.url.pathname, Astro.site).toString() },
  ],
};

// Rating medal colours
const medalClass = ['text-amber-400', 'text-slate-300', 'text-amber-600'];
const medalLabel = ['#1', '#2', '#3'];
---

<!doctype html>
<html lang="it" class="dark">
  <head>
    <BaseHead title={`${pageData.h1} | AI Tools Review`} description={pageData.metaDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body class="bg-light-bg dark:bg-ai-bg text-light-text dark:text-ai-text">
    <Header />

    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-16">

      <!-- Breadcrumb -->
      <nav class="text-sm text-light-muted dark:text-ai-muted mb-10 flex items-center gap-1.5">
        <a href="/" class="hover:text-ai-purple transition-colors">Home</a>
        <span>/</span>
        <a href="/strumenti" class="hover:text-ai-purple transition-colors">Strumenti</a>
        <span>/</span>
        <span class="text-light-text dark:text-ai-text font-medium">{pageData.h1}</span>
      </nav>

      <!-- Header -->
      <div class="mb-10">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-light-text dark:text-ai-text leading-tight mb-3">
          {pageData.h1}
        </h1>
        <p class="text-xs text-light-muted dark:text-ai-muted flex items-center gap-1.5 mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-ai-green animate-pulse"></span>
          Aggiornato {new Date().getFullYear()} · Testato sul campo · Nessun affiliato
        </p>
        <p class="text-base text-light-muted dark:text-ai-muted leading-relaxed max-w-2xl">
          {pageData.intro}
        </p>
      </div>

      <!-- ── 1. RISPOSTA RAPIDA: top 3 tools ──────────────────────────────── -->
      <section class="mb-14">
        <h2 class="text-xl font-extrabold text-light-text dark:text-ai-text mb-6">
          Risposta rapida — I migliori {topTools.length} tool
        </h2>
        <div class="space-y-3">
          {topTools.map((tool, i) => (
            <div class="flex items-start gap-4 p-5 rounded-2xl border
              bg-light-card dark:bg-ai-card border-light-border dark:border-ai-border
              hover:border-ai-purple/40 transition-colors">

              <!-- Rank medal -->
              <span class={`shrink-0 text-2xl font-black mt-0.5 ${medalClass[i]}`}>
                {medalLabel[i]}
              </span>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-0.5">
                  <span class="text-base font-extrabold text-light-text dark:text-ai-text">{tool.name}</span>
                  {tool.badge && (
                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-ai-purple/15 text-ai-purple">
                      {tool.badge}
                    </span>
                  )}
                  <span class="ml-auto shrink-0 text-sm font-bold text-emerald-500">
                    ★ {tool.ratings.overall.toFixed(1)}
                  </span>
                </div>
                <p class="text-sm text-light-muted dark:text-ai-muted mb-2">{tool.tagline}</p>

                <!-- Key strength (first one) -->
                <p class="text-xs text-light-text dark:text-ai-text">
                  <span class="text-emerald-500 font-bold">✓</span> {tool.strengths[0]}
                </p>

                <!-- Price -->
                <p class="text-xs text-light-muted dark:text-ai-muted mt-1">
                  {tool.pricing.hasFreeOption
                    ? '✦ Piano gratuito disponibile'
                    : tool.pricing.startingPriceUsd
                      ? `Da $${tool.pricing.startingPriceUsd}/mese`
                      : 'A pagamento'}
                </p>
              </div>

              <!-- CTA -->
              <a
                href={tool.link}
                class="shrink-0 self-center px-4 py-2 rounded-xl text-sm font-bold
                  bg-ai-purple hover:bg-ai-purple-dark text-white transition-all duration-150"
              >
                Scopri →
              </a>
            </div>
          ))}
        </div>
      </section>

      <!-- ── 2+3. QUANDO USARLO / QUANDO EVITARLO ─────────────────────────── -->
      <section class="mb-14">
        <h2 class="text-xl font-extrabold text-light-text dark:text-ai-text mb-6">
          Quando usare (e quando evitare) ogni tool
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {topTools.map(tool => (
            <div class="flex flex-col p-5 rounded-2xl border
              bg-light-card dark:bg-ai-card border-light-border dark:border-ai-border">

              <p class="text-sm font-extrabold text-light-text dark:text-ai-text mb-4">{tool.name}</p>

              <!-- Quando usarlo -->
              <p class="text-xs font-bold uppercase tracking-widest text-emerald-500 mb-2">Usalo per</p>
              <ul class="space-y-1.5 mb-5">
                {tool.strengths.map(s => (
                  <li class="flex items-start gap-2 text-xs text-light-text dark:text-ai-text leading-snug">
                    <span class="text-emerald-500 shrink-0 mt-0.5 font-bold">✓</span>{s}
                  </li>
                ))}
              </ul>

              <!-- Quando evitarlo -->
              <p class="text-xs font-bold uppercase tracking-widest text-red-400 mb-2">Evitalo se</p>
              <ul class="space-y-1.5 mb-5">
                {tool.weaknesses.map(w => (
                  <li class="flex items-start gap-2 text-xs text-light-muted dark:text-ai-muted leading-snug">
                    <span class="text-red-400 shrink-0 mt-0.5 font-bold">✕</span>{w}
                  </li>
                ))}
              </ul>

              <!-- Link recensione/confronto -->
              <a
                href={tool.link}
                class="mt-auto text-xs font-semibold text-ai-purple hover:underline"
              >
                Leggi la recensione →
              </a>
            </div>
          ))}
        </div>
      </section>

      <!-- ── CASI D'USO REALI ──────────────────────────────────────────────── -->
      <section class="mb-14">
        <h2 class="text-xl font-extrabold text-light-text dark:text-ai-text mb-6">
          Quale tool per ogni task concreto
        </h2>
        <div class="rounded-2xl border border-light-border dark:border-ai-border overflow-hidden">
          {useCasesResolved.map((uc, i) => (
            <div class={`grid grid-cols-[1fr_auto] gap-4 px-5 py-4 items-start
              ${i % 2 === 0 ? 'bg-light-card dark:bg-ai-card' : 'bg-light-bg dark:bg-ai-bg'}`}>
              <div>
                <p class="text-sm font-semibold text-light-text dark:text-ai-text mb-0.5">
                  {uc.task}
                </p>
                <p class="text-xs text-light-muted dark:text-ai-muted leading-relaxed">{uc.reason}</p>
              </div>
              {uc.tool && (
                <a
                  href={uc.tool.link}
                  class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-bold
                    bg-ai-purple/10 text-ai-purple hover:bg-ai-purple/20 transition-colors whitespace-nowrap"
                >
                  {uc.tool.name} →
                </a>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- ── 5. RACCOMANDAZIONI PER PROFILO ────────────────────────────────── -->
      <section class="mb-14">
        <h2 class="text-xl font-extrabold text-light-text dark:text-ai-text mb-6">
          Raccomandazione per il tuo profilo
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {profilesResolved.map(p => (
            <div class="p-5 rounded-2xl border
              bg-light-card dark:bg-ai-card border-light-border dark:border-ai-border">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-sm font-extrabold text-light-text dark:text-ai-text">{p.profile}</span>
                {p.badge && (
                  <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-ai-purple/10 text-ai-purple">
                    {p.badge}
                  </span>
                )}
              </div>
              <p class="text-xs text-light-muted dark:text-ai-muted mb-3 leading-relaxed">
                {p.description}
              </p>
              {p.tool && (
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-ai-purple">→ {p.tool.name}</span>
                  <a
                    href={p.tool.link}
                    class="text-xs text-light-muted dark:text-ai-muted hover:text-ai-purple transition-colors"
                  >
                    Scopri →
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- ── 4. CONFRONTI DIRETTI ──────────────────────────────────────────── -->
      {pairs.length > 0 && (
        <section class="mb-14">
          <h2 class="text-xl font-extrabold text-light-text dark:text-ai-text mb-2">
            Confronti diretti
          </h2>
          <p class="text-sm text-light-muted dark:text-ai-muted mb-6">
            Vuoi un confronto testa a testa? Scegli la coppia che ti interessa.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
            {pairs.map(p => (
              <a
                href={p.href}
                class="group flex items-center gap-2 px-4 py-3 rounded-xl border no-underline
                  transition-all duration-150
                  bg-light-card dark:bg-ai-card border-light-border dark:border-ai-border
                  hover:border-ai-purple/40 hover:shadow-md hover:shadow-ai-purple/5"
              >
                <span class="text-sm font-semibold text-light-text dark:text-ai-text
                  group-hover:text-ai-purple transition-colors truncate">
                  {p.nameA}
                </span>
                <span class="text-xs text-light-muted dark:text-ai-muted shrink-0">vs</span>
                <span class="text-sm font-semibold text-light-text dark:text-ai-text
                  group-hover:text-ai-purple transition-colors truncate">
                  {p.nameB}
                </span>
                <span class="ml-auto text-ai-purple opacity-0 group-hover:opacity-100
                  transition-opacity text-xs shrink-0">→</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
      <section class="mb-14">
        <h2 class="text-xl font-extrabold text-light-text dark:text-ai-text mb-6">
          Domande frequenti
        </h2>
        <div class="space-y-3">
          {pageData.faqs.map(faq => (
            <details class="group rounded-2xl border
              bg-light-card dark:bg-ai-card border-light-border dark:border-ai-border overflow-hidden">
              <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer
                text-sm font-semibold text-light-text dark:text-ai-text
                hover:text-ai-purple transition-colors list-none">
                {faq.question}
                <span class="shrink-0 text-light-muted dark:text-ai-muted
                  group-open:rotate-180 transition-transform duration-200 text-xs">▼</span>
              </summary>
              <div class="px-5 pb-5 pt-0">
                <p class="text-sm text-light-muted dark:text-ai-muted leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- ── CTA finale ────────────────────────────────────────────────────── -->
      <div class="p-8 rounded-2xl border text-center
        bg-gradient-to-br from-ai-purple/10 to-transparent border-ai-purple/20">
        <h2 class="text-xl font-extrabold text-light-text dark:text-ai-text mb-3">
          Non sei ancora sicuro? Descrivimi il tuo caso d'uso
        </h2>
        <p class="text-light-muted dark:text-ai-muted mb-6 max-w-md mx-auto text-sm leading-relaxed">
          L'AI Tool Advisor ti fa 3 domande e ti trova il tool più adatto al tuo profilo specifico — gratis.
        </p>
        <a
          href="/#ai-advisor"
          class="inline-flex items-center gap-2 px-6 py-3 bg-ai-purple hover:bg-ai-purple-dark
            text-white font-bold rounded-xl transition-all duration-200 text-sm"
        >
          Usa l'AI Tool Advisor →
        </a>
      </div>

    </main>

    <Footer />
  </body>
</html>

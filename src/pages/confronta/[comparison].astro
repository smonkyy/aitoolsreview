---
import { TOOLS } from '../../data/tools';
import { compareTools } from '../../lib/comparator';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FeedbackWidget from '../../components/FeedbackWidget.astro';

export function getStaticPaths() {
  const paths = [];

  for (let i = 0; i < TOOLS.length; i++) {
    for (let j = i + 1; j < TOOLS.length; j++) {
      const a = TOOLS[i];
      const b = TOOLS[j];
      const comparison = compareTools(a, b);

      paths.push({
        params: { comparison: comparison.slug },
        props:  { comparison },
      });
    }
  }

  return paths;
}

const { comparison } = Astro.props;
const { toolA, toolB, tldr, overallWinner } = comparison;

// SEO: descrizione dinamica generata dai dati, non hardcoded
const metaDesc = `${tldr.chooseA}. ${tldr.chooseB}. Confronto completo con funzionalità, prezzi, casi d'uso e verdetto finale — aggiornato ${new Date().getFullYear()}.`;

const canonicalUrl = `https://aitoolsreview.it/confronta/${comparison.slug}`;

// Structured data (FAQ schema) per Google rich snippets
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `${toolA.name} o ${toolB.name}: qual è il migliore?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: overallWinner
          ? `${overallWinner.name} è il vincitore complessivo in base ai nostri test. ${tldr.chooseA}. ${tldr.chooseB}.`
          : `Dipende dall'uso. ${tldr.chooseA}. ${tldr.chooseB}.`,
      },
    },
    {
      '@type': 'Question',
      name: `${toolA.name} ha un piano gratuito?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: toolA.pricing.hasFreeOption
          ? `Sì, ${toolA.name} offre un piano gratuito o freemium.`
          : `No, ${toolA.name} è a pagamento, a partire da $${toolA.pricing.startingPriceUsd}/mese.`,
      },
    },
    {
      '@type': 'Question',
      name: `${toolB.name} ha un piano gratuito?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: toolB.pricing.hasFreeOption
          ? `Sì, ${toolB.name} offre un piano gratuito o freemium.`
          : `No, ${toolB.name} è a pagamento, a partire da $${toolB.pricing.startingPriceUsd}/mese.`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="it" class="dark">
  <head>
    <BaseHead
      title={`${toolA.name} vs ${toolB.name}: Confronto ${new Date().getFullYear()} | AI Tools Review`}
      description={metaDesc}
    />
    <link rel="canonical" href={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body class="bg-light-bg dark:bg-ai-bg text-light-text dark:text-ai-text">
    <Header />

    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-16">

      <!-- ── Breadcrumb ──────────────────────────────────────────────────────── -->
      <nav class="text-sm text-light-muted dark:text-ai-muted mb-10 flex items-center gap-1.5">
        <a href="/" class="hover:text-ai-purple transition-colors">Home</a>
        <span>/</span>
        <a href="/strumenti" class="hover:text-ai-purple transition-colors">Strumenti</a>
        <span>/</span>
        <span class="text-light-text dark:text-ai-text font-medium">{toolA.name} vs {toolB.name}</span>
      </nav>

      <!-- ── Page header ────────────────────────────────────────────────────── -->
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-light-text dark:text-ai-text leading-tight mb-2">
          {toolA.name}
          <span class="text-light-muted dark:text-ai-muted font-light mx-2 text-2xl sm:text-3xl">vs</span>
          {toolB.name}
        </h1>
        <p class="text-xs text-light-muted dark:text-ai-muted flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-ai-green animate-pulse"></span>
          Dati aggiornati {new Date().getFullYear()} · Score su qualità, prezzo e facilità d'uso · Nessun affiliato
        </p>
      </div>

      <!-- ── Verdict box ────────────────────────────────────────────────────── -->
      <div class="mb-10 rounded-2xl border overflow-hidden
        bg-gradient-to-br from-ai-purple/10 to-transparent border-ai-purple/25">

        {overallWinner ? (
          <div class="p-6 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-widest text-ai-purple mb-2">Vincitore consigliato</p>
            <p class="text-2xl font-extrabold text-light-text dark:text-ai-text mb-1">{overallWinner.name}</p>
            <p class="text-light-muted dark:text-ai-muted text-sm mb-5">{overallWinner.tagline}</p>
            <div class="flex flex-wrap gap-3">
              <a
                href={overallWinner.link}
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-ai-purple hover:bg-ai-purple-dark text-white font-bold rounded-xl transition-all duration-200 text-sm"
              >
                {overallWinner.pricing.hasFreeOption ? `Prova ${overallWinner.name} gratis →` : `Scopri ${overallWinner.name} →`}
              </a>
              {(() => {
                const other = overallWinner.id === toolA.id ? toolB : toolA;
                return (
                  <a
                    href={other.link}
                    class="inline-flex items-center gap-2 px-5 py-2.5 border border-light-border dark:border-ai-border text-light-muted dark:text-ai-muted hover:text-light-text dark:hover:text-ai-text hover:border-ai-purple font-medium rounded-xl transition-all duration-200 text-sm"
                  >
                    Esplora {other.name}
                  </a>
                );
              })()}
            </div>
          </div>
        ) : (
          <div class="p-6 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-2">Pari merito</p>
            <p class="text-lg font-bold text-light-text dark:text-ai-text mb-1">Entrambi ottimi — dipende dal tuo caso d'uso</p>
            <p class="text-light-muted dark:text-ai-muted text-sm mb-5">Scorri i verdetti qui sotto per trovare quello giusto per te</p>
            <div class="flex flex-wrap gap-3">
              <a
                href={toolA.link}
                class="inline-flex items-center gap-2 px-5 py-2.5 border border-ai-purple text-ai-purple hover:bg-ai-purple hover:text-white font-bold rounded-xl transition-all duration-200 text-sm"
              >
                {toolA.pricing.hasFreeOption ? `Prova ${toolA.name} gratis →` : `Scopri ${toolA.name} →`}
              </a>
              <a
                href={toolB.link}
                class="inline-flex items-center gap-2 px-5 py-2.5 border border-light-border dark:border-ai-border text-light-muted dark:text-ai-muted hover:text-light-text dark:hover:text-ai-text hover:border-ai-purple font-medium rounded-xl transition-all duration-200 text-sm"
              >
                {toolB.pricing.hasFreeOption ? `Prova ${toolB.name} gratis` : `Scopri ${toolB.name}`}
              </a>
            </div>
          </div>
        )}

        <!-- TL;DR strip -->
        <div class="grid grid-cols-1 sm:grid-cols-2 border-t border-ai-purple/20">
          <div class="p-4 sm:border-r border-ai-purple/20">
            <p class="text-xs font-bold uppercase tracking-widest text-ai-purple mb-1">Scegli {toolA.name} se...</p>
            <p class="text-sm text-light-text dark:text-ai-text leading-relaxed">{tldr.chooseA.replace(`Scegli ${toolA.name} se `, '')}</p>
          </div>
          <div class="p-4 border-t sm:border-t-0 border-ai-purple/20">
            <p class="text-xs font-bold uppercase tracking-widest text-ai-purple mb-1">Scegli {toolB.name} se...</p>
            <p class="text-sm text-light-text dark:text-ai-text leading-relaxed">{tldr.chooseB.replace(`Scegli ${toolB.name} se `, '')}</p>
          </div>
        </div>

      </div>

      <!-- ── Main comparison ────────────────────────────────────────────────── -->
      <ComparisonTable comparison={comparison} />

      <!-- ── Feedback ──────────────────────────────────────────────────────── -->
      <FeedbackWidget slug={comparison.slug} />

      <!-- ── CTA finale ─────────────────────────────────────────────────────── -->
      <div class="mt-16 p-8 rounded-2xl border text-center
        bg-gradient-to-br from-ai-purple/10 to-transparent border-ai-purple/20">
        <h2 class="text-xl font-extrabold text-light-text dark:text-ai-text mb-3">
          Non riesci a scegliere? Descrivimi il tuo caso d'uso
        </h2>
        <p class="text-light-muted dark:text-ai-muted mb-6 max-w-md mx-auto text-sm leading-relaxed">
          L'AI Tool Advisor ti fa 3 domande e ti trova il tool più adatto al tuo profilo specifico.
        </p>
        <a
          href="/#ai-advisor"
          class="inline-flex items-center gap-2 px-6 py-3 bg-ai-purple hover:bg-ai-purple-dark text-white font-bold rounded-xl transition-all duration-200 text-sm"
        >
          Usa l'AI Tool Advisor →
        </a>
      </div>

      <!-- ── Related comparisons ────────────────────────────────────────────── -->
      {(() => {
        // Mostra fino a 3 confronti correlati (stesso tool A o B, diverso partner)
        const related = TOOLS
          .filter(t => t.id !== toolA.id && t.id !== toolB.id && t.category === toolA.category)
          .slice(0, 3);
        return related.length > 0 ? (
          <div class="mt-14">
            <h2 class="text-lg font-bold text-light-text dark:text-ai-text mb-4">Confronti correlati</h2>
            <div class="flex flex-wrap gap-2">
              {related.map(rel => (
                <a
                  href={`/confronta/${toolA.id}-vs-${rel.id}`}
                  class="px-4 py-2 rounded-full border text-sm font-medium transition-all duration-150 no-underline
                    text-light-muted border-light-border hover:text-light-text hover:bg-light-bg2
                    dark:text-ai-muted dark:border-ai-border dark:hover:text-ai-text dark:hover:bg-ai-card"
                >
                  {toolA.name} vs {rel.name}
                </a>
              ))}
              {related.map(rel => (
                <a
                  href={`/confronta/${toolB.id}-vs-${rel.id}`}
                  class="px-4 py-2 rounded-full border text-sm font-medium transition-all duration-150 no-underline
                    text-light-muted border-light-border hover:text-light-text hover:bg-light-bg2
                    dark:text-ai-muted dark:border-ai-border dark:hover:text-ai-text dark:hover:bg-ai-card"
                >
                  {toolB.name} vs {rel.name}
                </a>
              ))}
            </div>
          </div>
        ) : null;
      })()}

    </main>

    <Footer />

    <!-- ── Sticky CTA bar (appears when verdict scrolls out of view) ──────── -->
    <div
      id="sticky-bar"
      class="fixed bottom-0 inset-x-0 z-50 translate-y-full transition-transform duration-300
             border-t border-light-border dark:border-ai-border
             bg-light-bg/95 dark:bg-ai-bg/95 backdrop-blur-sm"
      aria-hidden="true"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4 flex-wrap">
        {overallWinner ? (
          <>
            <p class="text-sm font-semibold text-light-text dark:text-ai-text hidden sm:block">
              Vincitore consigliato: <span class="text-ai-purple">{overallWinner.name}</span>
            </p>
            <div class="flex gap-2 ml-auto">
              {(() => {
                const other = overallWinner.id === toolA.id ? toolB : toolA;
                return (
                  <>
                    <a
                      href={other.link}
                      class="px-4 py-2 rounded-xl border border-light-border dark:border-ai-border
                             text-light-muted dark:text-ai-muted text-sm font-medium
                             hover:border-ai-purple hover:text-ai-purple transition-all duration-150"
                    >
                      {other.name} →
                    </a>
                    <a
                      href={overallWinner.link}
                      class="px-4 py-2 rounded-xl bg-ai-purple hover:bg-ai-purple-dark text-white text-sm font-bold transition-all duration-150"
                    >
                      {overallWinner.pricing.hasFreeOption ? `Prova ${overallWinner.name} gratis →` : `Scopri ${overallWinner.name} →`}
                    </a>
                  </>
                );
              })()}
            </div>
          </>
        ) : (
          <div class="flex gap-2 ml-auto">
            <a
              href={toolA.link}
              class="px-4 py-2 rounded-xl border border-ai-purple text-ai-purple text-sm font-bold
                     hover:bg-ai-purple hover:text-white transition-all duration-150"
            >
              {toolA.pricing.hasFreeOption ? `Prova ${toolA.name} gratis →` : `${toolA.name} →`}
            </a>
            <a
              href={toolB.link}
              class="px-4 py-2 rounded-xl border border-light-border dark:border-ai-border
                     text-light-muted dark:text-ai-muted text-sm font-medium
                     hover:border-ai-purple hover:text-ai-purple transition-all duration-150"
            >
              {toolB.pricing.hasFreeOption ? `Prova ${toolB.name} gratis →` : `${toolB.name} →`}
            </a>
          </div>
        )}
      </div>
    </div>

  </body>
</html>

<!-- Sticky bar: show after verdict scrolls out of view -->
<script>
  const bar     = document.getElementById('sticky-bar')!;
  const verdict = document.querySelector<HTMLElement>('.mb-10.rounded-2xl');

  if (verdict) {
    const obs = new IntersectionObserver(
      ([entry]) => {
        const gone = !entry.isIntersecting;
        bar.classList.toggle('translate-y-full', !gone);
        bar.classList.toggle('translate-y-0', gone);
        bar.setAttribute('aria-hidden', String(!gone));
      },
      { threshold: 0 },
    );
    obs.observe(verdict);
  }
</script>

<!-- Analytics: comparison_view (fires once on load) -->
<div id="_atr-data" data-slug={comparison.slug} data-a={toolA.id} data-b={toolB.id} style="display:none" aria-hidden="true" />
<script>
  import { trackComparisonView, trackCtaClick } from '../../lib/analytics';

  const d = document.getElementById('_atr-data') as HTMLElement;
  trackComparisonView(d.dataset.slug!, d.dataset.a!, d.dataset.b!);

  // CTA click tracking
  document.querySelector('a[href="/#ai-advisor"]')?.addEventListener('click', () => {
    trackCtaClick('ai-advisor', d.dataset.slug);
  });
</script>

---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { TOOLS } from '../../data/tools';
import { getTopComparisons } from '../../lib/comparison-priority';
import { fetchTrending, buildTrendingMap } from '../../lib/trending';
import { fetchFeedback, buildFeedbackMap, fetchComparisonViews, buildViewsMap } from '../../lib/feedback';

const [trending, feedback, views] = await Promise.all([
  fetchTrending(),
  fetchFeedback(),
  fetchComparisonViews(),
]);
const trendingMap  = buildTrendingMap(trending);
const feedbackMap  = buildFeedbackMap(feedback);
const viewsMap     = buildViewsMap(views);
const topComparisons = getTopComparisons(9, trendingMap, viewsMap, feedbackMap);
const hasTrending  = trending.length > 0;

// Passed to client script
const toolsForPicker = TOOLS.map(t => ({ id: t.id, name: t.name, category: t.category }));
const toolOrder      = TOOLS.map(t => t.id);
---

<!doctype html>
<html lang="it" class="dark">
  <head>
    <BaseHead
      title="Confronta Strumenti AI | AI Tools Review"
      description="Confronta fianco a fianco i migliori strumenti AI. Scoring imparziale su use case, prezzi, qualità e facilità d'uso. Trova quale fa per te."
    />
  </head>
  <body class="bg-light-bg dark:bg-ai-bg text-light-text dark:text-ai-text">
    <Header />

    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12">

      <!-- ── Header — one line ───────────────────────────────────────────────── -->
      <div class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-light-text dark:text-ai-text mb-1">
          Confronta strumenti AI
        </h1>
        <p class="text-sm text-light-muted dark:text-ai-muted">
          Seleziona due tool per un confronto dettagliato su funzionalità, prezzi e verdetti.
        </p>
      </div>

      <!-- ── Autocomplete picker ─────────────────────────────────────────────── -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-end gap-3 mb-12">

        <!-- Tool A -->
        <div class="relative flex-1" id="containerA">
          <label for="inputA" class="block text-xs font-semibold uppercase tracking-widest
            text-light-muted dark:text-ai-muted mb-1.5">
            Primo tool
          </label>
          <div id="wrapA"
            class="flex items-center gap-2 px-3 py-2.5 rounded-xl border cursor-text
              bg-light-card dark:bg-ai-card border-light-border dark:border-ai-border
              focus-within:ring-2 focus-within:ring-ai-purple/40 focus-within:border-ai-purple/40
              transition-all duration-150"
          >
            <!-- Chip: shown when a tool is selected -->
            <span id="chipA"
              class="hidden items-center gap-1.5 shrink-0
                px-2 py-0.5 rounded-full bg-ai-purple/10 text-ai-purple text-sm font-medium">
              <span id="chipLabelA"></span>
              <button id="clearA" type="button"
                class="text-ai-purple/60 hover:text-ai-purple leading-none text-base"
                aria-label="Rimuovi selezione">×</button>
            </span>
            <!-- Input: hidden when chip is shown -->
            <input id="inputA" type="text" autocomplete="off" spellcheck="false"
              placeholder="es. ChatGPT, Claude…"
              class="flex-1 min-w-0 bg-transparent outline-none text-sm
                text-light-text dark:text-ai-text placeholder:text-light-muted dark:placeholder:text-ai-muted" />
          </div>
          <!-- Dropdown -->
          <ul id="dropdownA"
            class="hidden absolute z-30 top-full mt-1 w-full
              rounded-xl border border-light-border dark:border-ai-border
              bg-light-card dark:bg-ai-card shadow-xl overflow-hidden"
            role="listbox">
          </ul>
        </div>

        <!-- VS divider -->
        <span class="text-center sm:pb-2.5 font-bold text-light-muted dark:text-ai-muted shrink-0">vs</span>

        <!-- Tool B -->
        <div class="relative flex-1" id="containerB">
          <label for="inputB" class="block text-xs font-semibold uppercase tracking-widest
            text-light-muted dark:text-ai-muted mb-1.5">
            Secondo tool
          </label>
          <div id="wrapB"
            class="flex items-center gap-2 px-3 py-2.5 rounded-xl border cursor-text
              bg-light-card dark:bg-ai-card border-light-border dark:border-ai-border
              focus-within:ring-2 focus-within:ring-ai-purple/40 focus-within:border-ai-purple/40
              transition-all duration-150"
          >
            <span id="chipB"
              class="hidden items-center gap-1.5 shrink-0
                px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 text-sm font-medium">
              <span id="chipLabelB"></span>
              <button id="clearB" type="button"
                class="text-indigo-400/60 hover:text-indigo-400 leading-none text-base"
                aria-label="Rimuovi selezione">×</button>
            </span>
            <input id="inputB" type="text" autocomplete="off" spellcheck="false"
              placeholder="es. Midjourney, Gemini…"
              class="flex-1 min-w-0 bg-transparent outline-none text-sm
                text-light-text dark:text-ai-text placeholder:text-light-muted dark:placeholder:text-ai-muted" />
          </div>
          <ul id="dropdownB"
            class="hidden absolute z-30 top-full mt-1 w-full
              rounded-xl border border-light-border dark:border-ai-border
              bg-light-card dark:bg-ai-card shadow-xl overflow-hidden"
            role="listbox">
          </ul>
        </div>

        <!-- CTA -->
        <button id="compareBtn" disabled type="button"
          class="sm:mb-px px-6 py-2.5 rounded-xl font-bold text-sm transition-all duration-200 shrink-0
            bg-ai-purple text-white hover:bg-ai-purple-dark
            disabled:opacity-35 disabled:cursor-not-allowed">
          Confronta →
        </button>

      </div>

      <!-- ── Popular comparisons ─────────────────────────────────────────────── -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-light-muted dark:text-ai-muted mb-4">
          {hasTrending ? 'Più visti questa settimana' : 'Più cercati'}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
          {topComparisons.map(({ toolA, toolB, slug }) => (
            <a
              href={`/confronta/${slug}`}
              class="group flex items-center gap-2 px-4 py-3 rounded-xl border no-underline
                transition-all duration-150
                bg-light-card dark:bg-ai-card border-light-border dark:border-ai-border
                hover:border-ai-purple/40 hover:shadow-md hover:shadow-ai-purple/5"
            >
              <span class="text-sm font-semibold text-light-text dark:text-ai-text
                group-hover:text-ai-purple transition-colors truncate">
                {toolA.name}
              </span>
              <span class="text-xs text-light-muted dark:text-ai-muted shrink-0">vs</span>
              <span class="text-sm font-semibold text-light-text dark:text-ai-text
                group-hover:text-ai-purple transition-colors truncate">
                {toolB.name}
              </span>
              <span class="ml-auto text-ai-purple opacity-0 group-hover:opacity-100
                transition-opacity text-xs shrink-0">→</span>
            </a>
          ))}
        </div>
      </div>

    </main>

    <Footer />
  </body>
</html>

<!-- ── Autocomplete logic ──────────────────────────────────────────────────── -->
<script define:vars={{ toolsForPicker, toolOrder }}>
  /** @type {{ id: string; name: string; category: string }[]} */
  const tools = toolsForPicker;

  // ─── State ───────────────────────────────────────────────────────────────────

  let selectedA = null;
  let selectedB = null;

  // ─── Compare button ──────────────────────────────────────────────────────────

  const compareBtn = document.getElementById('compareBtn');

  function updateBtn() {
    compareBtn.disabled = !selectedA || !selectedB;
  }

  compareBtn.addEventListener('click', () => {
    if (!selectedA || !selectedB) return;
    const iA = toolOrder.indexOf(selectedA.id);
    const iB = toolOrder.indexOf(selectedB.id);
    const [first, second] = iA <= iB
      ? [selectedA.id, selectedB.id]
      : [selectedB.id, selectedA.id];
    window.location.href = `/confronta/${first}-vs-${second}`;
  });

  // ─── Autocomplete factory ────────────────────────────────────────────────────

  /**
   * @param {'A'|'B'} side
   */
  function makeAutocomplete(side) {
    const input     = /** @type {HTMLInputElement} */ (document.getElementById(`input${side}`));
    const dropdown  = document.getElementById(`dropdown${side}`);
    const chip      = document.getElementById(`chip${side}`);
    const chipLabel = document.getElementById(`chipLabel${side}`);
    const clearBtn  = document.getElementById(`clear${side}`);
    const wrap      = document.getElementById(`wrap${side}`);

    let activeIdx = -1;
    let results   = [];

    function getOtherSelected() {
      return side === 'A' ? selectedB : selectedA;
    }

    // ── Selection ──────────────────────────────────────────────────────────────

    function setSelected(tool) {
      if (side === 'A') selectedA = tool;
      else              selectedB = tool;

      chipLabel.textContent = tool.name;
      chip.classList.remove('hidden');
      chip.classList.add('flex');
      input.classList.add('hidden');
      input.value = '';
      closeDropdown();
      updateBtn();

      // Auto-focus the other input if empty
      const otherInput = document.getElementById(side === 'A' ? 'inputB' : 'inputA');
      const otherSelected = getOtherSelected(); // still old value, intentional
      if (!otherSelected) otherInput?.focus();
    }

    function clearSelected() {
      if (side === 'A') selectedA = null;
      else              selectedB = null;

      chip.classList.add('hidden');
      chip.classList.remove('flex');
      input.classList.remove('hidden');
      input.focus();
      updateBtn();
    }

    // ── Dropdown ───────────────────────────────────────────────────────────────

    function renderDropdown(items) {
      results   = items;
      activeIdx = -1;
      dropdown.innerHTML = '';

      if (items.length === 0) {
        const li = document.createElement('li');
        li.className = 'px-4 py-3 text-sm text-light-muted dark:text-ai-muted';
        li.textContent = 'Nessun risultato';
        dropdown.appendChild(li);
      } else {
        items.forEach((tool, i) => {
          const li = document.createElement('li');
          li.dataset.idx = String(i);
          li.setAttribute('role', 'option');
          li.className = `flex items-center justify-between px-4 py-2.5 text-sm cursor-pointer
            text-light-text dark:text-ai-text
            hover:bg-ai-purple/5`;
          li.innerHTML = `
            <span class="font-medium">${tool.name}</span>
            <span class="text-xs text-light-muted dark:text-ai-muted capitalize">${tool.category}</span>
          `;
          // mousedown instead of click — fires before blur, so closeDropdown doesn't steal it
          li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            setSelected(tool);
          });
          dropdown.appendChild(li);
        });
      }

      dropdown.classList.remove('hidden');
    }

    function closeDropdown() {
      dropdown.classList.add('hidden');
      activeIdx = -1;
    }

    function setActive(idx) {
      const items = dropdown.querySelectorAll('li[data-idx]');
      items.forEach((el, i) => el.classList.toggle('bg-ai-purple/5', i === idx));
      activeIdx = idx;
    }

    // ── Events ─────────────────────────────────────────────────────────────────

    input.addEventListener('input', () => {
      const q     = input.value.trim().toLowerCase();
      const other = getOtherSelected();
      if (!q) { closeDropdown(); return; }

      const filtered = tools
        .filter(t => t.id !== other?.id && t.name.toLowerCase().includes(q))
        .slice(0, 7);
      renderDropdown(filtered);
    });

    input.addEventListener('focus', () => {
      const q     = input.value.trim().toLowerCase();
      const other = getOtherSelected();
      if (!q) return;

      const filtered = tools
        .filter(t => t.id !== other?.id && t.name.toLowerCase().includes(q))
        .slice(0, 7);
      renderDropdown(filtered);
    });

    input.addEventListener('keydown', (e) => {
      const items = dropdown.querySelectorAll('li[data-idx]');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(Math.min(activeIdx + 1, items.length - 1));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(Math.max(activeIdx - 1, 0));
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIdx >= 0 && results[activeIdx]) setSelected(results[activeIdx]);
      } else if (e.key === 'Escape') {
        closeDropdown();
        input.blur();
      }
    });

    // Delay close so mousedown on dropdown items fires first
    input.addEventListener('blur', () => setTimeout(closeDropdown, 150));

    clearBtn.addEventListener('click', clearSelected);

    // Click anywhere on the wrap box focuses the input
    wrap.addEventListener('click', () => {
      if (!chip.classList.contains('hidden')) return;
      input.focus();
    });
  }

  makeAutocomplete('A');
  makeAutocomplete('B');
</script>

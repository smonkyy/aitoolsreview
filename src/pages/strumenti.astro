---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolSearch from '../components/ToolSearch';
---

<!doctype html>
<html lang="it" class="dark">
	<head>
		<BaseHead
			title="Tutti gli Strumenti AI | AI Tools Review"
			description="Scopri i migliori tool AI divisi per categoria: scrittura, immagini, video, audio, produttività, coding e molto altro. Testati e recensiti in italiano."
		/>
	</head>
	<body class="bg-light-bg dark:bg-ai-bg text-light-text dark:text-ai-text">
		<Header />

		<main class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
			<!-- Page header -->
			<div class="mb-10">
				<h1 class="text-4xl sm:text-5xl font-extrabold text-light-text dark:text-ai-text mb-4">
					Tutti gli strumenti AI
				</h1>
				<p class="text-light-muted dark:text-ai-muted text-xl max-w-2xl leading-relaxed">
					Oltre 20 tool testati, con ricerca semantica e filtri per trovare subito quello giusto per te.
				</p>
			</div>

			<!-- Interactive search + faceted filters (React, hydrated immediately) -->
			<ToolSearch client:load />

			<!-- Comparison CTA -->
			<div class="mt-20 p-8 rounded-2xl border
				bg-light-card dark:bg-ai-card border-light-border dark:border-ai-border">
				<div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
					<div class="flex-1">
						<p class="text-xs font-semibold text-ai-purple uppercase tracking-wide mb-2">Comparatore</p>
						<h2 class="text-xl font-extrabold text-light-text dark:text-ai-text mb-2">
							Non sai quale scegliere?
						</h2>
						<p class="text-sm text-light-muted dark:text-ai-muted leading-relaxed">
							Confronta due tool fianco a fianco: scoring su use case reali, prezzi, qualità e verdetto finale.
						</p>
					</div>
					<a
						href="/confronta"
						class="shrink-0 inline-flex items-center gap-2 px-6 py-3 bg-ai-purple hover:bg-ai-purple-dark text-white font-bold rounded-xl transition-all duration-200 text-sm"
					>
						Confronta strumenti →
					</a>
				</div>
			</div>

			<!-- Bottom CTA -->
			<div class="mt-8 p-8 rounded-2xl border text-center
				bg-gradient-to-br from-ai-purple/10 to-transparent
				border-ai-purple/20">
				<p class="text-lg text-light-muted dark:text-ai-muted mb-4">
					Nuove recensioni ogni settimana. Torna spesso!
				</p>
				<a
					href="/blog"
					class="inline-flex items-center gap-2 px-6 py-3 bg-ai-purple hover:bg-ai-purple-dark text-white font-bold rounded-xl transition-all duration-200"
				>
					Leggi tutte le recensioni →
				</a>
			</div>
		</main>

		<Footer />
	</body>
</html>

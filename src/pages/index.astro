---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="it">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section style="text-align: center; padding: 4rem 2rem;">
				<h1>Trova il tool AI giusto per te</h1>
				<p style="font-size: 1.2rem; color: #666; max-width: 600px; margin: 1rem auto;">
					Recensioni oneste e confronti approfonditi dei migliori strumenti di intelligenza artificiale. In italiano.
				</p>
				<a href="/blog" style="display: inline-block; margin-top: 1.5rem; padding: 0.8rem 2rem; background: #4f46e5; color: white; border-radius: 8px; text-decoration: none; font-weight: bold;">
					Leggi le recensioni
				</a>
			</section>

			<section style="max-width: 900px; margin: 0 auto; padding: 2rem;">
				<h2>Le categorie più cercate</h2>
				<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1.5rem;">
					<div style="padding: 1.5rem; border: 1px solid #e5e7eb; border-radius: 12px;">
						<h3>✍️ Scrittura</h3>
						<p style="color: #666;">Tool AI per scrivere testi, articoli e contenuti.</p>
						<a href="/blog">Scopri →</a>
					</div>
					<div style="padding: 1.5rem; border: 1px solid #e5e7eb; border-radius: 12px;">
						<h3>🎨 Immagini</h3>
						<p style="color: #666;">Generatori di immagini AI per creativi e designer.</p>
						<a href="/blog">Scopri →</a>
					</div>

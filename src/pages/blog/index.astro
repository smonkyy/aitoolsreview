---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function readingTime(body: string | undefined): number {
	return Math.max(1, Math.round((body?.split(/\s+/).length ?? 200) / 200));
}
---

<!doctype html>
<html lang="it" class="dark">
	<head>
		<BaseHead
			title={`Blog & Recensioni | ${SITE_TITLE}`}
			description="Tutte le recensioni e i confronti dei migliori tool AI — aggiornati e in italiano."
		/>
	</head>
	<body class="bg-light-bg dark:bg-ai-bg text-light-text dark:text-ai-text">
		<Header />

		<main class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
			<!-- Page header -->
			<div class="mb-14">
				<p class="text-ai-purple text-sm font-semibold uppercase tracking-widest mb-3">Tutto testato</p>
				<h1 class="text-4xl sm:text-5xl font-extrabold text-light-text dark:text-ai-text mb-4">
					Blog & Recensioni
				</h1>
				<p class="text-light-muted dark:text-ai-muted text-xl max-w-2xl leading-relaxed">
					{posts.length} recensioni approfondite, confronti e guide — tutto in italiano, testato davvero.
				</p>
			</div>

			<!-- Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{posts.map((post) => (
					<ReviewCard
						id={post.id}
						title={post.data.title}
						description={post.data.description}
						pubDate={post.data.pubDate}
						readTime={readingTime(post.body)}
						gradient=""
					/>
				))}
			</div>

			<!-- Empty state -->
			{posts.length === 0 && (
				<div class="text-center py-24">
					<div class="w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4
						bg-light-bg2 dark:bg-ai-card border border-light-border dark:border-ai-border">
						📝
					</div>
					<p class="text-light-muted dark:text-ai-muted text-lg">
						Le prime recensioni stanno arrivando. Torna presto!
					</p>
				</div>
			)}
		</main>

		<Footer />
	</body>
</html>

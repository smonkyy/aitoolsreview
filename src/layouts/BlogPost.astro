---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { AITool } from '../data/tools';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NewsletterForm from '../components/NewsletterForm';

type Props = CollectionEntry<'blog'>['data'] & {
  slug?: string;
  comparisonPair?: [AITool, AITool] | null;
  comparisonSlug?: string | null;
  /** JSON-LD SoftwareApplication schemas per i tool menzionati nel post */
  toolSchemas?: object[];
};

const { title, description, pubDate, updatedDate, heroImage, slug, comparisonPair, comparisonSlug, toolSchemas = [] } = Astro.props;
const ogImage = slug ? `/og/${slug}.png` : undefined;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = String(Astro.site);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  url: pageUrl,
  image: ogImage ? new URL(ogImage, Astro.site).toString() : undefined,
  publisher: { '@id': `${siteUrl}#organization` },
  author: { '@id': `${siteUrl}#organization` },
  isPartOf: { '@id': `${siteUrl}#website` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}blog` },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};
---

<html lang="it" class="dark">
	<head>
		<BaseHead title={title} description={description} ogImage={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		{toolSchemas.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}
	</head>

	<body class="bg-light-bg dark:bg-ai-bg text-light-text dark:text-ai-text">
		<Header />

		<main class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
			<article>
				<!-- Hero image -->
				{heroImage && (
					<div class="mb-8 rounded-2xl overflow-hidden">
						<Image
							width={896}
							height={504}
							src={heroImage}
							alt={title}
							class="w-full object-cover"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
				)}

				<!-- No hero image: gradient hero -->
				{!heroImage && (
					<div class="mb-10 h-52 sm:h-64 rounded-2xl relative overflow-hidden border border-light-border dark:border-ai-border">
						<div class="absolute inset-0 bg-gradient-to-br from-ai-purple/20 via-blue-500/10 to-transparent dark:from-ai-purple/25 dark:via-blue-500/15 dark:to-ai-bg"></div>
						<div
							class="absolute inset-0 opacity-[0.05]"
							style="background-image: linear-gradient(var(--color-ai-border) 1px, transparent 1px), linear-gradient(90deg, var(--color-ai-border) 1px, transparent 1px); background-size: 32px 32px;"
						></div>
						<div
							class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 rounded-full pointer-events-none"
							style="background: radial-gradient(ellipse, rgba(168,85,247,0.18) 0%, transparent 65%);"
						></div>
						<div class="absolute bottom-5 left-6 flex items-center gap-3">
							<span class="px-3 py-1.5 text-xs font-semibold rounded-full bg-ai-purple/20 text-ai-purple border border-ai-purple/30">
								Recensione
							</span>
						</div>
					</div>
				)}

				<!-- Article header -->
				<header class="mb-10">
					<!-- Breadcrumb / date -->
					<div class="flex items-center gap-3 text-sm text-light-faint dark:text-ai-faint mb-4">
						<a href="/blog" class="hover:text-ai-purple transition-colors">Blog</a>
						<span>/</span>
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="italic">· aggiornato <FormattedDate date={updatedDate} /></span>
						)}
					</div>

					<h1 class="text-3xl sm:text-4xl font-extrabold leading-tight mb-4
						text-light-text dark:text-ai-text">
						{title}
					</h1>
					<p class="text-lg text-light-muted dark:text-ai-muted leading-relaxed">
						{description}
					</p>

					<!-- Divider -->
					<div class="mt-8 h-px bg-gradient-to-r from-ai-purple/50 via-ai-border to-transparent
						dark:from-ai-purple/50 dark:via-ai-border"></div>
				</header>

				<!-- Article body -->
				<div class="prose-ai">
					<slot />
				</div>

				<!-- Inline comparison CTA — rendered only when 2+ tools are mentioned -->
				{comparisonPair && comparisonSlug && (
					<div class="mt-12 p-6 rounded-2xl border flex flex-col sm:flex-row items-start sm:items-center gap-5
						bg-light-card dark:bg-ai-card border-light-border dark:border-ai-border">
						<div class="flex-1 min-w-0">
							<p class="text-xs font-semibold text-ai-purple uppercase tracking-wide mb-1">
								Confronto diretto
							</p>
							<p class="font-bold text-light-text dark:text-ai-text text-base leading-snug">
								{comparisonPair[0].name} vs {comparisonPair[1].name}
							</p>
							<p class="text-sm text-light-muted dark:text-ai-muted mt-1 leading-relaxed">
								Scoring completo su use case, prezzi e funzionalità. Verdetto finale senza affiliazioni.
							</p>
						</div>
						<a
							href={`/confronta/${comparisonSlug}`}
							class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5
								bg-ai-purple hover:bg-ai-purple-dark text-white font-bold rounded-xl
								transition-all duration-200 text-sm no-underline whitespace-nowrap"
						>
							Confronta ora →
						</a>
					</div>
				)}

				<!-- Newsletter signup -->
				<NewsletterForm client:visible />

				<!-- Footer CTA -->
				<div class="mt-16 p-6 rounded-2xl border text-center
					bg-gradient-to-br from-ai-purple/10 to-transparent
					border-ai-purple/20 dark:border-ai-purple/20">
					<p class="text-light-muted dark:text-ai-muted mb-4">
						Hai trovato questa recensione utile? Esplora gli altri confronti.
					</p>
					<a
						href="/blog"
						class="inline-flex items-center gap-2 px-5 py-2.5 bg-ai-purple hover:bg-ai-purple-dark text-white font-semibold rounded-xl transition-all duration-200 text-sm"
					>
						Vedi tutte le recensioni →
					</a>
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>
